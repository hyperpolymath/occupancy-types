(* reject_drop_then_send.sir — BUG: use-after-drop.

   x is dropped, then sent as the message.  Linear ownership is gone.
   Expected: E_USE_AFTER_DROP. *)
letpair ep1 ep2 = new (!(Buf 4).End) in
let x = alloc 4 in
let _ = drop x in
let _ = send ep1 x in
unit
